MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
DB_NAME=scheduleApp
PORT=3000
CORS_ORIGIN=*

# PDF 匯入/匯出的隱藏資料加密——Root Key + HKDF 版本衍生機制。三者都選填，
# 完全不設定的話該功能停用，其他功能不受影響。

# 舊制單一金鑰（改版前的機制）。現在只用來解密「改版前就已經匯出、沒有版號欄位」
# 的舊格式 PDF，不會再用來加密任何新資料。若沒有這種舊 PDF 需要相容，可以不設定。
# 64 字元 hex 字串（32 bytes）：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PDF_PAYLOAD_SECRET=

# 唯一需要手動備份的值（存進密碼管理器/雲端筆記，跟主機分開放）。產生後永遠不變、
# 不重新產生——重新產生等於所有版本的金鑰全部跟著變，舊 PDF 全部解不開。
# 64 字元 hex 字串（32 bytes），產生方式同上。
PDF_PAYLOAD_ROOT_SECRET=

# 目前加密要用哪一版的「初始值」，例如 v1、v2……只有資料庫裡完全沒有版本狀態
# （系統第一次啟用這個機制）時才會讀這個值當起點，之後 DB 就是唯一的真相來源，
# 這個環境變數不會再被讀取——版本會每 30 天自動輪替，不需要手動改這裡或重啟。
# 實際加解密用的金鑰＝HKDF(PDF_PAYLOAD_ROOT_SECRET, info=版本號) 現場算出來，
# 不另外存成環境變數。
PDF_PAYLOAD_KEK_CURRENT=v1
